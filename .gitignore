# Secrets - never commit a live Stripe key
.env
.env.local
.env.*.local
*.pem

# Build output
bin/
dist/
/api

# Test + tooling
coverage.out
coverage.html
*.test
vendor/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Frontend
web/node_modules/
web/dist/
web/*.tsbuildinfo

# Production secrets
.env.production

# Stray screenshots dropped in the working tree. Deliberate images live in
# docs/screenshots and web/public, so those are excluded from the rule.
*.png
*.jpg
*.jpeg
!docs/screenshots/**
!web/public/**
