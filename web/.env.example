# Publishable key only. The secret key belongs to the Go service and must never
# reach a bundle: everything under VITE_ is compiled into the JavaScript that
# ships to the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Leave empty to use the Vite dev proxy (same origin, no CORS). Set to the
# backend's absolute URL when the UI is served from a different origin, and add
# that origin to CORS_ALLOWED_ORIGINS on the backend.
VITE_API_BASE_URL=

# UUID from the users table. Stands in for a session until authentication
# exists; the UI has no other way to identify the caller.
VITE_DEMO_USER_ID=

# Stripe price ids. Each must also appear in the backend's STRIPE_ALLOWED_PRICE_IDS.
VITE_PRICE_STARTER=
VITE_PRICE_PRO=
VITE_PRICE_SCALE=

# Where the dev proxy forwards /api. Defaults to http://localhost:8080.
VITE_DEV_PROXY_TARGET=
