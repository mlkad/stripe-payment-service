# Production configuration. Copy to .env.production in the repository root:
#
#   cp deployments/production/.env.production.example .env.production
#   chmod 600 .env.production
#
# This file holds live Stripe keys and the database password. It is gitignored;
# keep it that way, and prefer a secret manager over a file on disk once there
# is more than one machine.

APP_ENV=production
APP_NAME=stripe-payment-service

# --- Deployment ---------------------------------------------------------------
DOMAIN=billing.example.com
ACME_EMAIL=ops@example.com
VERSION=1.0.0

# --- HTTP ---------------------------------------------------------------------
# Caddy terminates TLS and forwards to 8080 on the internal network. Do not
# publish this port; the compose file deliberately does not.
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_API_TIMEOUT=10s
HTTP_WEBHOOK_TIMEOUT=25s

# Exactly one reverse proxy (Caddy) sits in front. This number must be right:
# too high and a caller picks their own rate-limit bucket by forging
# X-Forwarded-For, too low and everyone shares Caddy's bucket.
TRUSTED_PROXIES=1

# The UI's origin. Only needed if it is served from somewhere other than DOMAIN;
# same-origin deployments can leave this empty.
CORS_ALLOWED_ORIGINS=

# --- Observability ------------------------------------------------------------
# Second listener, scraped by Prometheus over the compose network. Never
# publish it: /metrics exposes request rates, error counts and business volume.
METRICS_PORT=9091

LOG_LEVEL=info
LOG_FORMAT=json

# --- Database -----------------------------------------------------------------
# DATABASE_URL is assembled by the compose file from these.
POSTGRES_USER=payments
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=payments

DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=30s

# --- Stripe -------------------------------------------------------------------
# Live keys. The service refuses to start with a test key when APP_ENV is
# production, and refuses a live key anywhere else.
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Must match the release train stripe-go deserialises against, and the version
# the webhook endpoint is pinned to in the Stripe dashboard.
STRIPE_API_VERSION=2026-08-26.dahlia

# Required in production: the price id arrives in the request body, so without
# an allowlist any caller can subscribe against any price in the account.
STRIPE_ALLOWED_PRICE_IDS=price_CHANGE_ME

STRIPE_CHECKOUT_SUCCESS_URL=https://billing.example.com/?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://billing.example.com/
STRIPE_CHECKOUT_RETURN_URL=https://billing.example.com/?session_id={CHECKOUT_SESSION_ID}
STRIPE_PORTAL_RETURN_URL=https://billing.example.com/

# --- Authentication -----------------------------------------------------------
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ISSUER=stripe-payment-service
JWT_AUDIENCE=stripe-payment-service-api
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Required in production. The refresh cookie outlives every access token, so
# sending it over plain HTTP is the worst transport mistake available.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=

BCRYPT_COST=12
AUTH_RATE_LIMIT_RPS=0.2
AUTH_RATE_LIMIT_BURST=5

# --- Background workers -------------------------------------------------------
WEBHOOK_SWEEPER_ENABLED=true
WEBHOOK_SWEEPER_INTERVAL=1m
WEBHOOK_SWEEPER_MAX_ATTEMPTS=6
WEBHOOK_STALE_CLAIM_AFTER=5m

PAYLOAD_RETENTION_ENABLED=true
PAYLOAD_RETENTION_INTERVAL=6h
PAYLOAD_RETENTION_SETTLED_AFTER=720h
PAYLOAD_RETENTION_UNSETTLED_AFTER=2160h
REFRESH_TOKEN_GRACE=168h
