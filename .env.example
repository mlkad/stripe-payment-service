# =============================================================================
# Copy to .env and fill in.  .env is gitignored - never commit real keys.
#   cp .env.example .env
# =============================================================================

# --- Runtime -----------------------------------------------------------------
APP_NAME=stripe-payment-service
APP_ENV=development            # development | staging | production
HTTP_PORT=8080
LOG_LEVEL=debug                # debug | info | warn | error
LOG_FORMAT=text                # text (local) | json (deployed)
LOG_ADD_SOURCE=false           # attach file:line; useful in staging
SHUTDOWN_TIMEOUT=15s           # how long to drain in-flight requests

# HTTP server timeouts. ReadHeaderTimeout must stay non-zero: it is the
# Slowloris defence.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Per-request deadlines applied by the router middleware. Both must be shorter
# than HTTP_WRITE_TIMEOUT, or the server drops the connection before the
# middleware can answer 503. The webhook deadline is the longer of the two:
# checkout.session.completed calls Stripe before it writes anything.
HTTP_API_TIMEOUT=10s
HTTP_WEBHOOK_TIMEOUT=25s

# Browser origins allowed to call the API, comma separated and matched exactly.
# Empty disables cross-origin access, which is correct when the UI is served
# from the same origin as the API. No wildcard: this API is called with
# credentials, so reflecting any origin would let any site read a user's
# billing data. In development the Vite proxy keeps the browser on one origin,
# so this is only needed when the UI is served separately.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=payments
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=payments
POSTGRES_PORT=5432

# Used by the API. Host is `postgres` inside compose, `localhost` from the host.
DATABASE_URL=postgres://payments:change_me_locally@localhost:5432/payments?sslmode=disable&pool_max_conns=25
# In production: sslmode=verify-full
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=10s
# Applied server-side to every session. Without a statement timeout one runaway
# query can hold a pool slot indefinitely and take the service down by
# exhaustion rather than by error.
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TX_TIMEOUT=60s
# Queries slower than this are logged at warn. 0 disables query tracing.
DB_SLOW_QUERY_THRESHOLD=200ms

# --- Goose (CLI usage outside docker) ----------------------------------------
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://payments:change_me_locally@localhost:5432/payments?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
# The version table is `goose_db_version` (goose default). It is settable only
# via the -table flag, not an env var - so we leave it alone.

# --- Rate limiting -------------------------------------------------------------
# Applies to POST /api/v1/auth/login and /register only. Those are the only
# routes where an anonymous caller can make the server do expensive work - one
# bcrypt comparison per request - and the only ones where unlimited attempts
# mean unlimited password guesses.
#
# Sustained refill in requests per second, and how many may arrive at once.
# 0.2/5 is one attempt every five seconds with a burst of five, which a human
# signing in never notices.
AUTH_RATE_LIMIT_RPS=0.2
AUTH_RATE_LIMIT_BURST=5

# Number of reverse proxies in front of this service. Must be exact.
# X-Forwarded-For is appended to by each hop, so the client is the Nth entry
# from the right; everything further left is caller-supplied. Too high and an
# attacker picks their own rate-limit bucket, too low and everyone behind the
# proxy shares one. 0 means no proxy - RemoteAddr is used directly.
TRUSTED_PROXIES=0

# --- Payload retention ---------------------------------------------------------
# processed_webhooks.payload holds the raw Stripe event, which carries customer
# email, name, billing address and card metadata. Retention replaces it with an
# allowlisted skeleton - event id, type, created, and the object's id - keeping
# an audit trail without keeping personal data.
PAYLOAD_RETENTION_ENABLED=true
PAYLOAD_RETENTION_INTERVAL=6h

# How long a succeeded or skipped event keeps its payload. These have no replay
# value left; the window exists so an operator can investigate a recent problem.
PAYLOAD_RETENTION_SETTLED_AFTER=720h   # 30 days

# Outer bound for a failed event. The sweeper replays from this column, so a
# failed event has to keep its payload for longer than a settled one - but not
# forever: a privacy obligation does not pause because a retry queue is stuck.
# Must comfortably exceed the sweeper's retry budget, which config checks.
PAYLOAD_RETENTION_UNSETTLED_AFTER=2160h  # 90 days

# Rows per batch. A pass keeps batching until nothing is due, so a backlog is
# cleared in one run rather than a batch per interval.
PAYLOAD_RETENTION_BATCH_SIZE=500

# How long an expired refresh token is kept before deletion. Not zero: reuse
# detection has to still fire on a token that expired between being stolen and
# being used, and a deleted row detects nothing.
REFRESH_TOKEN_GRACE=168h

# --- Webhook sweeper -----------------------------------------------------------
# Recovers and reports failed webhook deliveries. Stripe retries for three days
# and then gives up, so without this a bug fixed on day four leaves every event
# from days one to three permanently unprocessed, and nothing says so.
WEBHOOK_SWEEPER_ENABLED=true
WEBHOOK_SWEEPER_INTERVAL=1m

# Retry budget. Past it an event is dead-lettered and left alone: something is
# wrong that another attempt will not fix. The sweep then logs at error level.
WEBHOOK_SWEEPER_MAX_ATTEMPTS=6

# Backoff doubles per prior attempt, capped. Retrying every tick would turn a
# downstream outage into a tight loop against it.
WEBHOOK_SWEEPER_BASE_BACKOFF=30s
WEBHOOK_SWEEPER_MAX_BACKOFF=30m

# Rows per sweep, so a large backlog is worked through over several ticks.
WEBHOOK_SWEEPER_BATCH_SIZE=100

# How old the oldest unsettled event may get before the sweep logs at error
# level. A backlog that is getting older is a different problem from one that
# is merely large.
WEBHOOK_SWEEPER_ALERT_AFTER=1h

# How long a claim may sit in 'processing' before it is treated as abandoned by
# a crashed worker. Must exceed HTTP_WEBHOOK_TIMEOUT, or the sweeper steals work
# from a handler that is still running it.
WEBHOOK_STALE_CLAIM_AFTER=5m

# --- Observability -------------------------------------------------------------
# /metrics is served on its own listener, not the public API. It publishes
# request rates, error counts, in-flight concurrency and business volume, which
# is a map of the system for anyone probing it. Never publish this port past the
# reverse proxy. 0 disables metrics entirely.
METRICS_PORT=9091

# Restricts the metrics listener. Empty binds every interface, which inside a
# container network is what Prometheus needs; outside one, use 127.0.0.1.
METRICS_BIND_ADDRESS=

# --- Authentication ----------------------------------------------------------
# Signs and verifies access tokens. Anyone holding this can mint a token for
# any user id, so treat it exactly like the Stripe secret key.
#   openssl rand -base64 48
# Minimum 32 bytes; the service refuses to start on a placeholder value.
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48

# Verified on every token parse, so a token minted for staging cannot be
# replayed against production.
JWT_ISSUER=stripe-payment-service
JWT_AUDIENCE=stripe-payment-service-api

# Access tokens are stateless and cannot be revoked before they expire, so this
# is the whole containment window for a stolen one. Kept short because the
# refresh token below makes that affordable. Production is capped at 24h.
JWT_ACCESS_TOKEN_TTL=15m

# How long a session survives without renewal. Long, because unlike the access
# token this one is revocable - which is what makes a short access token
# practical. Every renewal rotates it, and presenting an already-rotated token
# is treated as theft: the whole session family is revoked.
REFRESH_TOKEN_TTL=720h

# Marks the refresh cookie Secure. Leave false only for plain-HTTP local
# development; the service refuses to start in production without it, because
# the refresh cookie outlives every access token.
AUTH_COOKIE_SECURE=false

# Empty for a host-only cookie, which is the safer default: a domain cookie is
# sent to every subdomain, so one compromised subdomain receives the token.
AUTH_COOKIE_DOMAIN=

# Each increment doubles the hashing work. 12 is ~250ms on current hardware:
# unnoticeable on a login, expensive across a stolen dump.
BCRYPT_COST=12

# --- Stripe ------------------------------------------------------------------
# Test-mode keys only in this file. https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen` locally, or the Dashboard endpoint in deployed envs.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Reject webhooks whose timestamp is older than this (replay-attack window).
STRIPE_WEBHOOK_TOLERANCE=300s
STRIPE_MAX_NETWORK_RETRIES=3
STRIPE_HTTP_TIMEOUT=20s

# Must match the release train the SDK deserialises against (stripe-go v86 ->
# "dahlia"). A webhook endpoint pinned to a different train has its events
# rejected, because fields outside the SDK's version decode as zero values.
STRIPE_API_VERSION=2026-08-26.dahlia

# Escape hatch for migrating an endpoint between API versions. Refused in
# production: objects would be deserialised against a version they were not
# rendered for.
STRIPE_IGNORE_API_VERSION_MISMATCH=false

# Where Stripe returns the browser after checkout. Must be https in production -
# the session id is appended to the success URL.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel

# Where Stripe sends the browser after an *embedded* checkout completes. Only
# used when the frontend asks for ui_mode=embedded.
STRIPE_CHECKOUT_RETURN_URL=http://localhost:5173/?session_id={CHECKOUT_SESSION_ID}

# Where Stripe sends the browser back after the customer finishes in the hosted
# billing portal (cancel, switch plan, update card). What the portal actually
# allows is configured in the Stripe dashboard, not here.
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/

# Comma-separated allowlist of prices /api/v1/checkout may be called with.
# Required in production: the price id arrives in the request body, so without
# this any caller can subscribe against any price in the account.
STRIPE_ALLOWED_PRICE_IDS=

# --- Checkout / Portal redirects --------------------------------------------
APP_BASE_URL=http://localhost:3000
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
PORTAL_RETURN_URL=http://localhost:3000/billing
